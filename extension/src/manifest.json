{
  "manifest_version": 3,
  "name": "Stockfish Analysis Board",
  "version": "1.1.0",
  "description": "Stockfish chess studio with opt-in tracking of a selected chessboard tab for analysis and recording.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [{
    "matches": ["https://stockfish.humza.website/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["studio-bridge.js"],
    "run_at": "document_start"
  }],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Stockfish studio · Follow this board",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
