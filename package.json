{
  "name": "stockfish-teaching-tools",
  "private": true,
  "description": "Stockfish analysis board (web app + browser extension) for chess teaching",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "web-app",
    "extension"
  ],
  "scripts": {
    "start": "npm run start -w web-app",
    "build": "npm run build -w extension",
    "test": "npm run build && npm test --workspaces",
    "deploy": "npm run deploy --prefix deploy",
    "deploy:check": "npm run check --prefix deploy"
  }
}
